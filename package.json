{
  "name": "presencer",
  "version": "1.0.0",
  "private": true,
  "description": "Gestione presenze e turni, PWA e app Android",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/serve-ui.mjs",
    "build:native": "node scripts/build-native.mjs",
    "prepare:web": "npm run build:native && node scripts/prepare-web.mjs",
    "android:sync": "npm run prepare:web && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "apk:debug": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.25.9"
  }
}
